# Kopyalayıp .env olarak kaydedin. .env dosyası git'e gönderilmez.
# Varsayılan: bilgisayarınızda çalışan ücretsiz Ollama (https://ollama.com)
MIZAN_LLM_BASE_URL=http://localhost:11434/v1
MIZAN_LLM_API_KEY=ollama
MIZAN_LLM_MODEL=qwen2.5:7b

# OpenAI örneği:
# MIZAN_LLM_BASE_URL=https://api.openai.com/v1
# MIZAN_LLM_API_KEY=sk-...
# MIZAN_LLM_MODEL=<sağlayıcının güncel model adı>

# Google Gemini örneği (ücretsiz kota var):
# MIZAN_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# MIZAN_LLM_API_KEY=...
# MIZAN_LLM_MODEL=<sağlayıcının güncel model adı>
